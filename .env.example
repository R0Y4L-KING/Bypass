# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Sirf API KEY yahan daalo — poora URL nahi.
# (URL neeche API_URL me hai, aur bot.py me already default hai)
KEY=your-api-key-here

# Bot ka username, without @  (aapka: KingBypassRobot)
BOT_USERNAME=KingBypassRobot

# Force-subscribe channels: comma separated
# @username ya -100... id dono chalte hain
# Bot ko in channels me ADMIN banana zaroori hai
# FSUB_CHANNELS=@mychannel,-1001234567890

# --- optional (defaults already set in bot.py) ---
# API_URL=https://altaf-api-maker.base44.app/functions/lookup
# TOOL=nick-bypass
# TIMEOUT=45
