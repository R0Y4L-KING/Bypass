# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Sirf API KEY yahan daalo — poora URL nahi.
KEY=your-api-key-here

# Bot ka username, without @
BOT_USERNAME=KingBypassRobot

# Force-subscribe channels: comma separated (bina space)
FSUB_CHANNELS=@ModAppsKing,@EduAppsKing

# Force-sub banner image ka direct link
FSUB_PIC=https://raw.githubusercontent.com/R0Y4L-KING/Bypass/main/assets/banner.jpg

# Force-sub message ka custom text (optional)
# {name} ki jagah user ka naam aa jaata hai
# FSUB_MSG=HELLO {name}\n\n<b><blockquote>JOIN OUR CHANNELS...</blockquote></b>

# --- optional (defaults already set in bot.py) ---
# API_URL=https://altaf-api-maker.base44.app/functions/lookup
# TOOL=nick-bypass
# TIMEOUT=45
