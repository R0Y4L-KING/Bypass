# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Sirf API KEY yahan daalo — poora URL nahi.
KEY=your-api-key-here

# Bot ka username, without @
BOT_USERNAME=KingBypassRobot

# Messages ke neeche credit line
CREDIT=ModAppsKing

# Result message kitne second baad delete ho (0 = kabhi nahi)
AUTO_DELETE=60

# User ka bheja link message turant delete karna hai? (1 = haan, 0 = nahi)
DELETE_USER_MSG=1

# Kitne second baad "Still working…" dikhe
NUDGE_AFTER=12

# Poore bypass ka hard cap (khali = TIMEOUT*2+15)
# HARD_LIMIT=105

# /start ka thumbnail (khali karo to bina photo ke)
START_PIC=https://raw.githubusercontent.com/R0Y4L-KING/Bypass/main/assets/fsub-banner.jpg

# Force-subscribe channels: comma separated (bina space)
FSUB_CHANNELS=@ModAppsKing,@EduAppsKing

# Force-sub banner image ka direct link
FSUB_PIC=https://raw.githubusercontent.com/R0Y4L-KING/Bypass/main/assets/fsub-banner.jpg

# ---- Reactions ----
REACT_EVERY=👀
REACT_START=⚡
REACT_OK=🔥
REACT_FAIL=😢

# --- optional ---
# API_URL=https://altaf-api-maker.base44.app/functions/lookup
# TOOL=nick-bypass
# TIMEOUT=45
